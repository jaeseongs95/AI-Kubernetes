{
  "name": "aik-windows-foundation-spike",
  "version": "0.1.0",
  "private": true,
  "description": "AIK-002 Windows GUI, isolated IPC, Python sidecar and user vault spike",
  "author": "AI-Kubernetes contributors",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build --base=./",
    "test": "node --test tests/*.test.cjs",
    "start": "electron .",
    "package:win": "electron-builder --config ../../packaging/electron-builder.cjs --win --x64 --publish never"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
