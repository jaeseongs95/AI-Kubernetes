{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIK Tauri Comparison",
  "version": "0.1.0",
  "identifier": "io.github.jaeseongs95.aik.tauri-comparison",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "AI-Kubernetes · Tauri 후보 비교",
        "width": 1120,
        "height": 840,
        "minWidth": 880,
        "minHeight": 700,
        "visible": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../../../packaging/build/engine/aik-engine/": "engine/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Korean"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
